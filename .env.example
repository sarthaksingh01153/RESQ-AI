# Database
DATABASE_URL="file:./dev.db"

# Auth
JWT_SECRET="change-this-to-a-long-random-secret-in-production"
NEXTAUTH_URL="http://localhost:3000"

# AI Provider (Google Gemini)
# Get your key at https://aistudio.google.com/
GEMINI_API_KEY=""

# Weather - Open-Meteo is free and requires no API key
# WEATHER_API_KEY=""

# Optional: Email notifications (e.g., Resend)
# RESEND_API_KEY=""
# EMAIL_FROM="noreply@resqai.example.com"

# Optional: Upload directory (default: public/uploads)
# UPLOAD_DIR="public/uploads"

# Feature flags
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_MAP_TILES="https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png"
NEXT_PUBLIC_DEMO_MODE="true"

